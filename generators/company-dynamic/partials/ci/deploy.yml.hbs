name: Deploy

on:
  workflow_run:
    workflows: [CI]
    types: [completed]
    branches:
      - main
      - develop
  workflow_dispatch:
    inputs:
      stage:
        description: SST stage to deploy
        required: true
        default: production
        type: choice
        options:
          - dev
          - staging
          - production

permissions:
  contents: read
  id-token: write
  actions: read

concurrency:
  group: {{gha 'github.workflow'}}-{{gha "github.event_name == 'workflow_run' && github.event.workflow_run.head_branch || github.ref_name"}}
  cancel-in-progress: true

jobs:
  deploy-dev:
    name: Deploy dev
    if: {{gha "github.event_name == 'workflow_run' && github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.head_branch == 'develop'"}}
    uses: {{idpRepo}}/.github/workflows/reusable-deploy-sst.yml@{{idpRef}}
    with:
      stage: dev
      aws-region: {{awsRegion}}
      git-ref: {{gha 'github.event.workflow_run.head_sha'}}

  deploy-staging:
    name: Deploy staging
    if: {{gha "github.event_name == 'workflow_run' && github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.head_branch == 'main'"}}
    uses: {{idpRepo}}/.github/workflows/reusable-deploy-sst.yml@{{idpRef}}
    with:
      stage: staging
      aws-region: {{awsRegion}}
      git-ref: {{gha 'github.event.workflow_run.head_sha'}}

  deploy-production:
    name: Deploy production
    if: {{gha "github.event_name == 'workflow_dispatch' && github.event.inputs.stage == 'production'"}}
    uses: {{idpRepo}}/.github/workflows/reusable-deploy-sst.yml@{{idpRef}}
    with:
      stage: production
      aws-region: {{awsRegion}}
      git-ref: {{gha 'github.sha'}}

  deploy-manual-dev:
    name: Deploy dev (manual)
    if: {{gha "github.event_name == 'workflow_dispatch' && github.event.inputs.stage == 'dev'"}}
    uses: {{idpRepo}}/.github/workflows/reusable-deploy-sst.yml@{{idpRef}}
    with:
      stage: dev
      aws-region: {{awsRegion}}
      git-ref: {{gha 'github.sha'}}

  deploy-manual-staging:
    name: Deploy staging (manual)
    if: {{gha "github.event_name == 'workflow_dispatch' && github.event.inputs.stage == 'staging'"}}
    uses: {{idpRepo}}/.github/workflows/reusable-deploy-sst.yml@{{idpRef}}
    with:
      stage: staging
      aws-region: {{awsRegion}}
      git-ref: {{gha 'github.sha'}}
