{
  "name": "${{ values.name }}",
  "version": "0.1.0",
  "private": true,
  "description": "${{ values.description }}",
  "workspaces": [
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:client\" \"npm:dev:admin\"",
    "dev:backend": "npm run start:dev -w backend",
    "dev:client": "npm run dev -w client",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "deploy": "sst deploy",
    "deploy:dev": "sst deploy --stage dev",
    "deploy:staging": "sst deploy --stage staging",
    "deploy:prod": "sst deploy --stage production"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "sst": "^3.4.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
