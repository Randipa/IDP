# GitHub integration (required for scaffolder and repo operations)
GITHUB_TOKEN=

# SonarQube (Backstage plugin + CI)
SONARQUBE_BASE_URL=http://localhost:9000
SONARQUBE_EXTERNAL_URL=http://localhost:9000
SONARQUBE_API_KEY=

# GitHub OAuth (production IDP deploy)
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# PostgreSQL (used with docker compose + app-config.local.yaml)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage
POSTGRES_DB=backstage
