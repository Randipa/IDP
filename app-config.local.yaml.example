# Copy to app-config.local.yaml for persistent local development with PostgreSQL.
# cp app-config.local.yaml.example app-config.local.yaml

backend:
  database:
    client: pg
    connection:
      host: ${POSTGRES_HOST}
      port: ${POSTGRES_PORT}
      user: ${POSTGRES_USER}
      password: ${POSTGRES_PASSWORD}
      database: ${POSTGRES_DB}

catalog:
  locations:
    - type: file
      target: ../../catalog-info.yaml

    - type: file
      target: ../../catalog/org/groups.yaml
      rules:
        - allow: [Group]

    - type: file
      target: ../../catalog/org/users.yaml
      rules:
        - allow: [User]

    - type: file
      target: ../../catalog/systems.yaml
      rules:
        - allow: [System, Domain]

    - type: file
      target: ../../catalog/resources.yaml
      rules:
        - allow: [Resource]

    - type: file
      target: ../../catalog/components/reference-services.yaml
      rules:
        - allow: [Component]

    - type: file
      target: ../../catalog/templates/nestjs-api/template.yaml
      rules:
        - allow: [Template]

    - type: file
      target: ../../catalog/templates/nextjs-fullstack/template.yaml
      rules:
        - allow: [Template]
