# Copy to app-config.local.yaml for persistent local development with PostgreSQL.
# cp app-config.local.yaml.example app-config.local.yaml

backend:
  database:
    client: pg
    connection:
      host: ${POSTGRES_HOST}
      port: ${POSTGRES_PORT}
      user: ${POSTGRES_USER}
      password: ${POSTGRES_PASSWORD}
      database: ${POSTGRES_DB}

catalog:
  locations:
    - type: file
      target: ../../catalog/bootstrap.yaml

    - type: file
      target: ../../catalog/templates/nestjs-api/template.yaml
      rules:
        - allow: [Template]

    - type: file
      target: ../../catalog/templates/nextjs-fullstack/template.yaml
      rules:
        - allow: [Template]
